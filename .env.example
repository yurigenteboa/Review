# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API, ou o botão "Connect" no topo do painel).
# O .env.local NÃO vai para o GitHub (está no .gitignore).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=cole-a-chave-anon-public-aqui

# "off" esconde o botão "Continuar com o Google" (padrão: aparece)
VITE_LOGIN_GOOGLE=
